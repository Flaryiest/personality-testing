# Copy this file to .env and fill in your key.
OPENAI_API_KEY=sk-...

# BMO's speaking voice (optional: without it the kiosk bleeps instead)
ELEVENLABS_API_KEY=sk_...

# Optional overrides (defaults live in lockbox/config.py)
# LOCKBOX_MODEL=gpt-5.5
# LOCKBOX_STT_MODEL=gpt-4o-transcribe
# LOCKBOX_VOICE_ID=your-elevenlabs-voice-id
# LOCKBOX_TTS_MODEL=eleven_flash_v2_5
# LOCKBOX_STATE_PATH=state/progress.json

# Hosted playground for testers (set these on the host, not for the booth kiosk)
# LOCKBOX_PLAYGROUND=1
# LOCKBOX_ACCESS_CODE=some-code-testers-get-in-their-link
